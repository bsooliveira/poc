[Unit]
Description=SimpliFAQ - modelos locais Ollama

[Container]
Image=docker.io/ollama/ollama:0.18.0
ContainerName=simplfaq-ollama
Network=simplfaq.network
NetworkAlias=simplfaq-ollama
Volume=simplfaq-models.volume:/root/.ollama
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_KEEP_ALIVE=5m
Environment=OLLAMA_HOST=0.0.0.0:11434
NoNewPrivileges=true
DropCapability=ALL
HealthCmd=ollama list
HealthInterval=30s
HealthTimeout=10s

[Service]
Restart=always
TimeoutStartSec=900
MemoryMax=5G

[Install]
WantedBy=default.target
