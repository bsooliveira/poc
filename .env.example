# POC local: nunca publicar AUTH_MODE=local em uma interface externa.
ENVIRONMENT=development
AUTH_MODE=local
LLM_PROVIDER=ollama
OLLAMA_URL=http://simplfaq-ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TRAINING_MODEL=Qwen/Qwen2.5-0.5B-Instruct
DATA_DIR=/data
HF_HOME=/data/models/huggingface
TOKENIZERS_PARALLELISM=false
OMP_NUM_THREADS=2
MAX_UPLOAD_MB=25
MAX_BATCH_MB=100
CHUNK_SIZE=1400
CHUNK_OVERLAP=180
RETRIEVAL_TOP_K=8
RETRIEVAL_THRESHOLD=0.12
LLM_TIMEOUT=600
OLLAMA_MAX_PROMPT_CHARS=18000
# Integrações opcionais fora do escopo da POC:
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_AUDIENCE=
# ENTRA_GROUP_ID=
# B3_API_URL=
# B3_API_KEY=
# B3_MODEL=
